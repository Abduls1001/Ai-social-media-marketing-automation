# Environment variables for AI Social Media Operations Platform
# Copy this file to .env.local and fill in the values.

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project credentials
# Find these in your Supabase project settings under API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini credentials (Phase 7 — AI Content Generation)
# Used by the "Generate AI Caption" / "Regenerate Caption" button on
# the Posts module. Server-side only — never exposed to the browser.
GEMINI_API_KEY=

# Optional: override the model used for caption generation.
# Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=
